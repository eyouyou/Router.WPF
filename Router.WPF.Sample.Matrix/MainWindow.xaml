<Window x:Class="Router.WPF.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Router.WPF.Sample"
        xmlns:vm="clr-namespace:Router.WPF.Sample.ViewModels"
        mc:Ignorable="d"
        Title="Router.WPF Matrix Navigation Sample"
        Height="760"
        Width="1280"
        MinHeight="600"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="PrimaryNavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#312E45"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeatureButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#ECECF1"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F1F4"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LeftNavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#312E45"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsLeftNavigationOpen, Converter={x:Static local:BooleanToGridLengthConverter.Instance}, ConverterParameter=156}"/>
            <ColumnDefinition Width="{Binding IsFeaturePanelOpen, Converter={x:Static local:BooleanToGridLengthConverter.Instance}, ConverterParameter=240}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top-level business navigation controls the contextual feature list. -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ToggleLeftNavigationCommand}"
                            ToolTip="Show or hide left navigation">
                        <TextBlock Text="&#xE700;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ToggleFeaturePanelCommand}"
                            ToolTip="Show or hide the feature panel">
                        <TextBlock Text="&#xE76C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"/>
                    </Button>
                </StackPanel>

                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding OpenRoutes.Items}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TopNavigationButton}"
                                    Command="{Binding DataContext.ActivateOpenRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Tag>
                                    <MultiBinding Converter="{x:Static local:EqualityConverter.Instance}">
                                        <Binding/>
                                        <Binding Path="DataContext.OpenRoutes.ActiveItem"
                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Button.Tag>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;"
                                               Margin="0,0,7,0"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="7"
                            Height="7"
                            Margin="0,0,7,0"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="4"/>
                    <TextBlock Text="Router ready"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The left tab only controls the small list rendered below it. -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#F7F7F9"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Height="68"
                        Padding="18,0"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Local routes"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Contextual tools"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding LeftNavigationItems}" Margin="6,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LeftNavigationButton}"
                                    Command="{Binding DataContext.SelectLeftNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Tag>
                                    <MultiBinding Converter="{x:Static local:EqualityConverter.Instance}">
                                        <Binding/>
                                        <Binding Path="DataContext.ActiveLeftNavigation"
                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Button.Tag>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Dynamic tabs and their small feature lists. -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#F7F7F9"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Height="68"
                        Padding="18,0"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveLeftNavigation.Title}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Features"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom"
                        Padding="14,12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="CURRENT ROUTE"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentPath}"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TabControl ItemsSource="{Binding AggregatedTabs}"
                            SelectedItem="{Binding ActiveSideTab}"
                            Margin="10,10,10,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0">
                    <!-- Dynamic tabs are shown above the small feature list. -->
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       Padding="5,2"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer Margin="-4,10,-4,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2,0,2,8"
                                                    Padding="12,10"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Padding="7,3"
                                                            Background="{StaticResource AccentSoftBrush}"
                                                            CornerRadius="5"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Value}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- Main content and global tools. -->
        <DockPanel Grid.Row="1" Grid.Column="2">
            <Border DockPanel.Dock="Top"
                    Height="68"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding BackCommand}"
                                ToolTip="Go back">
                            <TextBlock Text="&#xE72B;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding ForwardCommand}"
                                Margin="2,0,0,0"
                                ToolTip="Go forward">
                            <TextBlock Text="&#xE72A;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding RefreshCommand}"
                                Margin="2,0,0,0"
                                ToolTip="Refresh">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="14,0"
                            MaxWidth="560"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="#F5F5F7"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="12,0,0,0"
                                       Text="&#xE71B;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding AddressBarPath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="9,8"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding NavigateToAddressCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2"
                                    Style="{StaticResource ToolbarButton}"
                                    Command="{Binding NavigateToAddressCommand}"
                                    ToolTip="Navigate">
                                <TextBlock Text="&#xE751;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource ChromeTextBox}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="31,7,28,7"/>
                        <TextBlock Text="&#xE721;"
                                   Margin="10,0,0,0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{StaticResource MutedBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Search routes"
                                   Margin="31,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="Clear search">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11"/>
                        </Button>

                        <Popup IsOpen="{Binding SearchResults.Count, Mode=OneWay, Converter={x:Static local:GreaterThanZeroConverter.Instance}}"
                               PlacementTarget="{Binding ElementName=SearchAnchor}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Width="280"
                                    Margin="0,6,0,0"
                                    Padding="6"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                      Opacity="0.12"
                                                      BlurRadius="18"
                                                      ShadowDepth="3"/>
                                </Border.Effect>
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarButton}"
                                                    Foreground="{StaticResource TextBrush}"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Path}"
                                                    Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Key}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding Path}"
                                                               Style="{StaticResource Mono}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="10"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                        <Border x:Name="SearchAnchor"
                                Height="1"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource StatusBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,8">
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource Muted}"
                               FontSize="11"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalHistoryCount}"
                                   Style="{StaticResource Mono}"
                                   FontSize="11"/>
                        <TextBlock Text=" history entries"
                                   Style="{StaticResource Muted}"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource BgBrush}">
                <ContentControl x:Name="RouterHost"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
