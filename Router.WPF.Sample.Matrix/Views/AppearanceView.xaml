<UserControl x:Class="Router.WPF.Sample.Views.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32" MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource H1}"/>
                <TextBlock Text="Picking a theme navigates to /preferences/{theme}." Style="{StaticResource Muted}" Margin="0,0,0,24"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource H3}"/>
                        <TextBlock Text="Choose how Router.WPF Sample looks." Style="{StaticResource Muted}" Margin="0,4,0,16"/>

                        <UniformGrid Columns="3">
                            <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                                    Padding="0"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="/preferences/light">
                                <Border Width="220" Height="120" CornerRadius="6" Background="#F8FAFC" Padding="14">
                                    <StackPanel>
                                        <Border Width="140" Height="14" Background="#E2E8F0" CornerRadius="3" HorizontalAlignment="Left"/>
                                        <Border Width="100" Height="10" Background="#CBD5E1" CornerRadius="3" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        <TextBlock Text="Light" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,18,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                                    Padding="0"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="/preferences/dark">
                                <Border Width="220" Height="120" CornerRadius="6" Background="#0F172A" Padding="14">
                                    <StackPanel>
                                        <Border Width="140" Height="14" Background="#1E293B" CornerRadius="3" HorizontalAlignment="Left"/>
                                        <Border Width="100" Height="10" Background="#334155" CornerRadius="3" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        <TextBlock Text="Dark" FontWeight="SemiBold" Foreground="White" Margin="0,18,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Margin="0" Style="{StaticResource SecondaryButton}"
                                    Padding="0"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="/preferences/auto">
                                <Border Width="220" Height="120" CornerRadius="6" Padding="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F8FAFC" Offset="0"/>
                                            <GradientStop Color="#0F172A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <Border Width="140" Height="14" Background="#94A3B8" CornerRadius="3" HorizontalAlignment="Left"/>
                                        <Border Width="100" Height="10" Background="#475569" CornerRadius="3" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        <TextBlock Text="Auto" FontWeight="SemiBold" Foreground="White" Margin="0,18,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
