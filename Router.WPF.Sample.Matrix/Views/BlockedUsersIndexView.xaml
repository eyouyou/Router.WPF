<UserControl x:Class="Router.WPF.Sample.Views.BlockedUsersIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Border Style="{StaticResource Tag}" HorizontalAlignment="Left" Margin="0,0,0,12">
                <TextBlock Text="IndexRoute (default child)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#EEF0FF">
                                    <TextBlock Text="{Binding DisplayName[0]}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="  ·  " Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.OpenUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}">
                                    <TextBlock Text="Open →"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
