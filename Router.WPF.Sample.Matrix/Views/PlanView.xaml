<UserControl x:Class="Router.WPF.Sample.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Plan #" Style="{StaticResource H3}"/>
                <TextBlock Text="{Binding PlanId}" Style="{StaticResource H3}" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12">
                A leaf route. Click below to walk the visual tree and list the route matches the framework
                associates with this element.
            </TextBlock>
            <Button x:Name="ShowMatchesBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                    Click="ShowMatchesBtn_Click">
                <TextBlock Text="Inspect GetRouteMatches()"/>
            </Button>

            <ItemsControl ItemsSource="{Binding RouteMatches}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F4F4F6" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
