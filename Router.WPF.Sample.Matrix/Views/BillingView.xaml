<UserControl x:Class="Router.WPF.Sample.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Router.Wpf;assembly=Router.WPF"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32" MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="Billing &amp; plans" Style="{StaticResource H1}"/>
                <TextBlock Text="Parent route. Children render in the outlet below." Style="{StaticResource Muted}" Margin="0,0,0,24"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Open the plans window for a user" Style="{StaticResource H3}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12">
                            Routes /plans-and-usage/{userId:int} through a WindowHandler. ExtraData is passed
                            to the navigation event and shown in the status bar.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="user id" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource ChromeTextBox}" Width="120" Text="{Binding UserIdInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Cascadia Mono, Consolas, monospace"/>
                            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenPlansCommand}">
                                <TextBlock Text="Open plans window"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Outlet" Style="{StaticResource Label}"/>
                        <Border Background="{StaticResource BgBrush}" CornerRadius="6" Padding="0" Margin="0,8,0,0" MinHeight="120"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <r:Outlet/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
