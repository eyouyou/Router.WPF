<Window x:Class="Router.WPF.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Router.WPF.Sample"
        xmlns:vm="clr-namespace:Router.WPF.Sample.ViewModels"
        mc:Ignorable="d"
        Title="Router.WPF Sample" Height="720" Width="1200"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 侧栏 ========== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,18,20,16">
                    <StackPanel>
                        <TextBlock Text="Router.WPF" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Feature gallery" Foreground="{StaticResource SidebarMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="14,12,14,14" BorderThickness="0,1,0,0" BorderBrush="#26262E">
                    <StackPanel>
                        <DockPanel Margin="6,0,6,2">
                            <TextBlock Text="HISTORY" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10">
                                <Run Text="{Binding History.Count, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding TotalHistoryCount, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding History}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,3" CornerRadius="4" Margin="0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="#262630"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,8">
                        <TextBlock Text="ROUTES" Margin="22,8,20,6" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding SidebarItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarButton}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Path}">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ========== 主内容区 ========== -->
        <DockPanel Grid.Column="1">

            <!-- 顶部工具栏 -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding BackCommand}" ToolTip="Go back">
                            <TextBlock Text="&#x2190;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ForwardCommand}" Margin="2,0,0,0" ToolTip="Go forward">
                            <TextBlock Text="&#x2192;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}" Margin="2,0,0,0" ToolTip="Refresh">
                            <TextBlock Text="&#x21BB;" FontSize="16"/>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1" Margin="12,0" Background="#F4F4F6"
                            CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="path" Style="{StaticResource Label}"
                                       VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Padding="6,7" FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="13" VerticalContentAlignment="Center"
                                     Text="{Binding AddressBarPath, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding NavigateToAddressCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Style="{StaticResource ToolbarButton}"
                                    Command="{Binding NavigateToAddressCommand}" ToolTip="Navigate (Enter)">
                                <TextBlock Text="&#x23CE;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <TextBox Style="{StaticResource ChromeTextBox}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="32,6,28,6"/>
                        <TextBlock Text="&#x2315;" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="Search routes…" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="32,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding ClearSearchCommand}" Margin="0,0,2,0" ToolTip="Clear">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#x2715;" FontSize="12"/>
                        </Button>

                        <!-- 搜索结果弹层 -->
                        <Popup IsOpen="{Binding SearchResults.Count, Mode=OneWay, Converter={x:Static local:GreaterThanZeroConverter.Instance}}"
                               PlacementTarget="{Binding ElementName=SearchAnchor}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="White" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    Width="280" Margin="0,4,0,0" Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.12" BlurRadius="16" ShadowDepth="2"/>
                                </Border.Effect>
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarButton}"
                                                    Foreground="{StaticResource TextBrush}"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Path}"
                                                    Margin="0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                        <Border x:Name="SearchAnchor" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="1"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 状态栏 -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Border Background="{StaticResource SuccessBrush}" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <TextBlock Text="current: " Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Mono}" FontSize="12"/>
                        <TextBlock Text="  ·  history: " Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalHistoryCount}" Style="{StaticResource Mono}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Router 视图宿主 -->
            <Border Background="{StaticResource BgBrush}">
                <ContentControl x:Name="RouterHost" Padding="0"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
