<UserControl x:Class="Router.WPF.Sample.Views.SpendingLimitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Spending limits" Style="{StaticResource H3}"/>
            <TextBlock Text="Inherits the Billing parent route — rendered through Outlet." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
            <UniformGrid Columns="3">
                <StackPanel>
                    <TextBlock Text="MONTHLY LIMIT" Style="{StaticResource Label}"/>
                    <TextBlock Text="$500.00" Style="{StaticResource Body}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="USED" Style="{StaticResource Label}"/>
                    <TextBlock Text="$148.30" Style="{StaticResource Body}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="REMAINING" Style="{StaticResource Label}"/>
                    <TextBlock Text="$351.70" Style="{StaticResource Body}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
