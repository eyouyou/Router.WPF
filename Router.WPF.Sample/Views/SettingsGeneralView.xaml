<UserControl x:Class="Router.WPF.Sample.Views.SettingsGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel Margin="20">
        <TextBlock Text="General" Style="{StaticResource H2}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16">
            Display name, language, default workspace.
        </TextBlock>
        <UniformGrid Columns="2">
            <StackPanel>
                <TextBlock Text="DISPLAY NAME" Style="{StaticResource Label}"/>
                <TextBlock Text="Eyou You" Style="{StaticResource Body}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="LANGUAGE" Style="{StaticResource Label}"/>
                <TextBlock Text="English (US)" Style="{StaticResource Body}" Margin="0,4,0,0"/>
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>
