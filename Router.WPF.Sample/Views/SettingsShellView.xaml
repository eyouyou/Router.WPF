<UserControl x:Class="Router.WPF.Sample.Views.SettingsShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Router.Wpf;assembly=Router.WPF"
             Background="{StaticResource BgBrush}"
             MinWidth="640" MinHeight="420">
    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border Style="{StaticResource Tag}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Window route" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="IsMultiple = false" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="IsRouteRef = true" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,12,0,4"/>
            <TextBlock Style="{StaticResource Muted}">
                The same Window stays open as you switch tabs — only the inner content swaps.
                Closing the route (navigate elsewhere) closes the Window.
            </TextBlock>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6" Margin="0,0,16,0">
                <StackPanel>
                    <Button Style="{StaticResource SidebarButton}"
                            Foreground="{StaticResource TextBrush}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="/settings/general">
                        <TextBlock Text="General"/>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}"
                            Foreground="{StaticResource TextBrush}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="/settings/security">
                        <TextBlock Text="Security"/>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}"
                            Foreground="{StaticResource TextBrush}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="/settings/notifications">
                        <TextBlock Text="Notifications"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <r:Outlet/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
